<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template (v2). install.sh replaces __LAUNCHER__ (installed launcher "Spotify-Kontowechsel") and
  __MA_DIR__ (~/Library/Application Support/spotify-multiaccount), XML-escaped,
  and writes the result to ~/Library/LaunchAgents/com.spotify-multiaccount.switcher.plist.

  launchd socket activation: launchd owns 127.0.0.1:48655 and starts the helper
  on the first connection; the helper exits by itself when idle. No RunAtLoad,
  no KeepAlive.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spotify-multiaccount.switcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>__LAUNCHER__</string>
    </array>
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockNodeName</key>
            <string>127.0.0.1</string>
            <key>SockServiceName</key>
            <string>48655</string>
            <key>SockType</key>
            <string>stream</string>
            <key>SockFamily</key>
            <string>IPv4</string>
        </dict>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>WorkingDirectory</key>
    <string>__MA_DIR__</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>__MA_DIR__/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__MA_DIR__/launchd.log</string>
</dict>
</plist>
